{
    "manifest_version": 3,
    "name": "LeetCode Reminder",
    "version": "0.0.1",
    "description": "Email reminders for LeetCode problems you solved.",
    "action": {
        "icons": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        },
        "default_icon":"icon.png",
        "default_title": "LeetCode Reminder",
        "default_popup": "popup.html"
    },
    "options_page": "options.html",
    "permissions": [
        "identity",
        "cookies",
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost:8000/*",
        "https://*.clerk.accounts.dev/*",
        "https://legal-dove-96.clerk.accounts.dev/*",
        "https://api.clerk.com/*",
        "Add own domain later"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://legal-dove-96.clerk.accounts.dev https://api.clerk.com http://localhost:8000;"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    }
}