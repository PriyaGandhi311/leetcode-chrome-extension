{
    "manifest_version": 3,
    "name": "LeetCode Reminder",
    "version": "0.0.1",
    "description": "Email reminders for LeetCode problems you solved.",
    "action": {
        "icons": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        },
        "default_icon":"icon.png",
        "default_title": "LeetCode Reminder",
        "default_popup": "popup.html"
    },
    "options_page": "options.html",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost:8000/*",
        "Add own domain later"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    }
}